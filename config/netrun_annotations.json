{
  "extra": {
    "description": "AISI AI job-ad annotation pipeline. Reads ad_ids from a completed exposure run, joins to adzuna for text, applies a deterministic AI keyword prefilter, then runs all six LLM annotation passes (Batch 1: boolean AI detection + seniority; Batch 2: AI mention context + AI requirement; Batch 3: worker AI tool use + quality/remote/agency). Structurally independent from config/netrun.json so the exposure pipeline cannot accidentally re-execute. Eligibility per pass is driven by per-batch route knobs (full | post_filter) read from the routing node."
  },
  "node_vars": {
    "run_name": {
      "type": "str"
    },
    "sample_n": {
      "type": "int"
    },
    "llm_model": {
      "type": "str"
    },
    "sbatch_cache": {
      "type": "bool"
    },
    "duckdb_memory_limit": {
      "type": "str"
    },
    "temperature": {
      "type": "float"
    },
    "top_p": {
      "type": "float"
    },
    "top_k": {
      "type": "int"
    }
  },
  "storage": {
    "cache": {
      "enabled": false,
      "include_all_nodes": true,
      "storage_path": ".cache/netrun_annotations"
    }
  },
  "pools": {
    "main": {
      "spec": {
        "type": "thread",
        "num_workers": 4
      }
    }
  },
  "max_epochs": 1,
  "retries": 10,
  "retry_wait": 30,
  "project_root_override": "../",
  "graph": {
    "nodes": [
      {
        "name": "build_annotation_universe",
        "description": "Source node: read ad_ids from the upstream exposure run, join to adzuna for title/description, write annotation_universe_v1.parquet.",
        "execution_config": {
          "run_on_init": true,
          "node_vars": {
            "input_run_name": {
              "type": "str"
            }
          },
          "signals": [
            "epoch_finished"
          ]
        },
        "extra": {
          "source_path": "src/ai_annotations/nodes/build_annotation_universe.py"
        },
        "factory": "netrun.node_factories.from_function",
        "factory_args": {
          "func": "ai_annotations.nodes.build_annotation_universe.main"
        },
        "type": "node"
      },
      {
        "name": "pass0_ai_keyword_prefilter",
        "description": "Deterministic AI keyword prefilter over the universe. No LLM.",
        "execution_config": {
          "signals": [
            "epoch_finished"
          ]
        },
        "extra": {
          "source_path": "src/ai_annotations/nodes/pass0_ai_keyword_prefilter.py"
        },
        "factory": "netrun.node_factories.from_function",
        "factory_args": {
          "func": "ai_annotations.nodes.pass0_ai_keyword_prefilter.main"
        },
        "type": "node"
      },
      {
        "name": "build_annotation_routing",
        "description": "Compute per-ad eligibility flags for all six LLM passes.",
        "execution_config": {
          "node_vars": {
            "batch1_route": {
              "type": "str"
            },
            "batch2_route": {
              "type": "str"
            },
            "batch3_route": {
              "type": "str"
            },
            "pass5_route": {
              "type": "str"
            },
            "pass6_route_override": {
              "type": "str"
            }
          },
          "signals": [
            "epoch_finished"
          ]
        },
        "extra": {
          "source_path": "src/ai_annotations/nodes/build_annotation_routing.py"
        },
        "factory": "netrun.node_factories.from_function",
        "factory_args": {
          "func": "ai_annotations.nodes.build_annotation_routing.main"
        },
        "type": "node"
      },
      {
        "name": "broadcast_routing",
        "description": "Fan out the routing output to all six LLM passes.",
        "factory": "netrun.node_factories.broadcast",
        "factory_args": {
          "num_outputs": 6
        },
        "type": "node"
      },
      {
        "name": "pass1_boolean_ai_detection",
        "description": "LLM pass 1: nine boolean AI-salience flags + confidence + evidence.",
        "execution_config": {
          "node_vars": {
            "llm_model": { "inherit": true },
            "sbatch_cache": { "inherit": true },
            "temperature": { "inherit": true },
            "top_p": { "inherit": true },
            "top_k": { "inherit": true },
            "duckdb_memory_limit": { "inherit": true },
            "sbatch_time": { "type": "str" },
            "chunk_size": { "type": "int" },
            "max_new_tokens": { "type": "int" },
            "max_concurrent_chunks": { "type": "int" },
            "pass_resume": { "type": "bool" },
            "pass_max_retries": { "type": "int" },
            "pass_raise_on_failure": { "type": "bool" },
            "system_prompt": { "type": "str" },
            "user_prompt": { "type": "str" },
            "prompt_version": { "type": "str" }
